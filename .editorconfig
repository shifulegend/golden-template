# EditorConfig — Control 3.3.1 (UTF-8, spaces, LF, column limits)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.{py,go,rs,c,h,cpp,hpp,java,cs}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
max_line_length = 80

[Makefile]
indent_style = tab
